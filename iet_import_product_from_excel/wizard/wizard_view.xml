<?xml version="1.0"?>
<odoo>

    <record id="import_excel_view_form" model="ir.ui.view">
        <field name="name">import.excel.form</field>
        <field name="model">import.excel</field>
        <field name="arch" type="xml">
            <form string="Import Excel">
                <group>
                    <field name="import_excel"/>
                </group>
                <footer>
                    <button name="import_sale_orders" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_import" model="ir.actions.act_window">
        <field name="name">Wizard Import</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">import.excel</field>
        <field name="view_mode">form</field>
        <!--        <field name="view_id" ref="view_hr_attendance_view_filter" />-->
        <field name="target">new</field>
    </record>

    <menuitem id="menu_import_excel"
              name="Import Product"
              parent="stock.menu_stock_root"
              action="action_wizard_import" sequence="100"/>

</odoo>
