<odoo>
    <record id="view_employee_form_inherit_payment" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.payment</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="work_email" position="after">
                <field name="employee_payment_type"/>
            </field>
        </field>
    </record>


    <record id="view_payslip_form_inherit_payment" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.payment</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <field name="struct_id" position="after">
                <field name="employee_payment_type"/>
            </field>
        </field>
    </record>

</odoo>