        <record id="id_product_template_only_form_view_inherits" model="ir.ui.view">
            <field name="name">product_template_only_form_view_inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <style>
                    .rtl-field {
                    direction: rtl;
                    }
                </style>

                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="class">rtl-field</attribute>
                </xpath>
                <xpath expr="//h1" position="after">
                    <h1>
                        <div class="d-flex">
                            <field class="text-break" name="arabic_name" placeholder="Arabic Name"
                                   style="direction: rtl;"/>
                        </div>
                    </h1>
                </xpath>
            </field>
        </record>

        <record id="id_product_form_view_inherits" model="ir.ui.view">
            <field name="name">product__form_view_inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <style>
                    .rtl-field {
                    direction: rtl;
                    }
                </style>

                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="class">rtl-field</attribute>
                </xpath>

                <xpath expr="//h1" position="after">
                    <h1>
                        <div class="d-flex">
                            <field class="text-break" name="arabic_name" placeholder="Arabic Name"
                                   style="direction: rtl;"/>
                        </div>
                    </h1>
                </xpath>
            </field>
        </record>
