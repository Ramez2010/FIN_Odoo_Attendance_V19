<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="id_product_template_only_form_view_inherits" model="ir.ui.view">
            <field name="name">product_template_only_form_view_inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='name']" position="before">
                    <style>
                        .rtl-field {
                        direction: rtl;
                        }
                    </style>
                </xpath>

                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="class">rtl-field</attribute>
                </xpath>

                <xpath expr="//h1" position="after">
                    <h1>
                        <div class="d-flex">
                            <field class="text-break" name="arabic_name" placeholder="Arabic Name"
                                   style="direction: rtl;"/>
                        </div>
                    </h1>
                </xpath>
            </field>
        </record>

        <record id="id_product_form_view_inherits" model="ir.ui.view">
            <field name="name">product__form_view_inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='name']" position="before">
                    <style>
                        .rtl-field {
                        direction: rtl;
                        }
                    </style>
                </xpath>

                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="class">rtl-field</attribute>
                </xpath>

                <xpath expr="//h1" position="after">
                    <h1>
                        <div class="d-flex">
                            <field class="text-break" name="arabic_name" placeholder="Arabic Name"
                                   style="direction: rtl;"/>
                        </div>
                    </h1>
                </xpath>
            </field>
        </record>

        <record id="id_purchase_order_form_view_inherits" model="ir.ui.view">
            <field name="name">purchase.order.form_view_inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                    <field name="arabic_name"/>
                </xpath>
            </field>
        </record>


        <record id="product_template_search_view_inherit" model="ir.ui.view">
            <field name="name">product.template.search.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="arabic_name" string="Arabic Name" filter_domain="[('arabic_name','ilike',self)]"/>
                </xpath>
            </field>
        </record>

        <record id="view_product_product_tree_inherit" model="ir.ui.view">
            <field name="name">product.product.tree.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="arabic_name"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>