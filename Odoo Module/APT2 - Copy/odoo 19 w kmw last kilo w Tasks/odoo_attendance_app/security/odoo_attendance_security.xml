<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Security Group for FIN Attendance Managers -->
        <record id="group_odoo_attendance_manager" model="res.groups">
            <field name="name">FIN Attendance Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="comment">Can manage mobile app employee accounts and sessions</field>
        </record>

        <!-- Employee Task access: self, assigned by me, or team hierarchy -->
        <record id="rule_fin_employee_task_employee_access" model="ir.rule">
            <field name="name">Employee Tasks: Self/Team Access</field>
            <field name="model_id" ref="model_fin_employee_task"/>
            <field name="domain_force">['|', ('manager_id', '=', user.employee_id.id), ('employee_id', 'child_of', user.employee_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Managers can view tasks for employees in their hierarchy -->
        <record id="rule_fin_employee_task_manager_access_all" model="ir.rule">
            <field name="name">Employee Tasks: Manager Full Access</field>
            <field name="model_id" ref="model_fin_employee_task"/>
            <field name="domain_force">[('employee_id', 'child_of', user.employee_id.id)]</field>
            <field name="groups" eval="[(4, ref('odoo_attendance_app.group_odoo_attendance_manager'))]"/>
        </record>

        <record id="rule_fin_employee_task_hr_access_all" model="ir.rule">
            <field name="name">Employee Tasks: HR Full Access</field>
            <field name="model_id" ref="model_fin_employee_task"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
    </data>
</odoo>
