<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_attendance_app" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.attendance.app</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_request_live_location"
                            type="object"
                            class="oe_highlight"
                            string="Request Live Location"
                            groups="hr.group_hr_user,hr_attendance.group_hr_attendance_officer"
                            invisible="attendance_state != 'checked_in'"/>
                </header>
            </xpath>
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page name="attendance_app_tracking" string="Live Tracking" groups="hr.group_hr_user,odoo_attendance_app.group_odoo_attendance_manager">
                    <group>
                        <group string="Configuration">
                            <field name="tracking_enabled" widget="boolean_toggle"/>
                            <field name="tracking_device_identifier"/>
                        </group>
                        <group string="Help">
                            <div class="text-muted">
                                <p>Enable <strong>Live Tracking</strong> to allow this employee to appear on the Live Map.</p>
                                <p>The "Device Identifier" is optional and used for mapping via MDM if applicable. For the standard Mobile App, the system links via the logged-in user.</p>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
