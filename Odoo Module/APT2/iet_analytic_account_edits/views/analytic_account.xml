<odoo>
    <data>
        <record id="set_analytic_account_sequence_code" model="ir.actions.server">
            <field name="name">Set Analytic Account ID</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="binding_model_id" ref="analytic.model_account_analytic_account"/>
            <field name="state">code</field>
            <field name="code">
                action = records.action_set_analytic_account_sequence_code()
            </field>
        </record>


        <record model="ir.ui.view" id="analytic_account_search_inherit">
            <field name="name">analytic_account_search_inherit</field>
            <field name="model">account.analytic.account</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_account_search"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <separator/>
                    <field name="code"/>
                </field>
            </field>
        </record>

    </data>
</odoo>