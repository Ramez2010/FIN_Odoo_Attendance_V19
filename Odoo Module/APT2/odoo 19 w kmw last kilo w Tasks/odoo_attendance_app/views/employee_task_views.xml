<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fin_employee_task_tree" model="ir.ui.view">
        <field name="name">fin.employee.task.tree</field>
        <field name="model">fin.employee.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="assignee_ids"/>
                <field name="manager_id"/>
                <field name="analytic_account_id"/>
                <field name="target_start_date"/>
                <field name="target_end_date"/>
                <field name="progress"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="last_update_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fin_employee_task_form" model="ir.ui.view">
        <field name="name">fin.employee.task.form</field>
        <field name="model">fin.employee.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="assignee_ids" widget="many2many_tags"/>
                            <field name="manager_id"/>
                            <field name="analytic_account_id"/>
                            <field name="priority"/>
                            <field name="estimated_hours"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="target_start_date"/>
                            <field name="target_end_date"/>
                            <field name="progress"/>
                            <field name="status" readonly="1"/>
                            <field name="last_update_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="update_note" placeholder="Latest update note"/>
                        <separator string="Update History" colspan="2"/>
                        <field name="update_history_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="updated_at"/>
                                <field name="progress"/>
                                <field name="update_note"/>
                                <field name="updated_by_employee_id" optional="hide"/>
                                <field name="updated_by_user_id" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fin_employee_task_search" model="ir.ui.view">
        <field name="name">fin.employee.task.search</field>
        <field name="model">fin.employee.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="assignee_ids"/>
                <field name="manager_id"/>
                <field name="analytic_account_id"/>
                <filter string="Pending" name="pending" domain="[('status','=','pending')]"/>
                <filter string="In Process" name="in_process" domain="[('status','=','in_process')]"/>
                <filter string="Done" name="done" domain="[('status','=','done')]"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="view_fin_employee_task_dashboard_report_search" model="ir.ui.view">
        <field name="name">fin.employee.task.dashboard.report.search</field>
        <field name="model">fin.employee.task.dashboard.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="analytic_account_id"/>
                <field name="primary_employee_id"/>
                <field name="assignee_employee_id"/>
                <field name="employee_id"/>
                <field name="status"/>
                <field name="target_start_date"/>
                <field name="target_end_date"/>
            </search>
        </field>
    </record>

    <record id="view_fin_employee_task_dashboard_report_graph" model="ir.ui.view">
        <field name="name">fin.employee.task.dashboard.report.graph</field>
        <field name="model">fin.employee.task.dashboard.report</field>
        <field name="arch" type="xml">
            <graph string="Task Progress Dashboard" type="bar" stacked="False">
                <field name="analytic_account_id" type="row"/>
                <field name="status" type="col"/>
                <field name="progress_pct" type="measure" string="Average Progress (%)" operator="avg"/>
                <field name="task_count" type="measure" string="Tasks"/>
            </graph>
        </field>
    </record>

    <record id="view_fin_employee_task_dashboard_report_pivot" model="ir.ui.view">
        <field name="name">fin.employee.task.dashboard.report.pivot</field>
        <field name="model">fin.employee.task.dashboard.report</field>
        <field name="arch" type="xml">
            <pivot string="Task Progress Matrix">
                <field name="analytic_account_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="status" type="col"/>
                <field name="progress_pct" type="measure" string="Average Progress (%)" operator="avg"/>
                <field name="task_count" type="measure" string="Tasks"/>
            </pivot>
        </field>
    </record>

    <record id="view_fin_employee_task_dashboard_report_tree" model="ir.ui.view">
        <field name="name">fin.employee.task.dashboard.report.list</field>
        <field name="model">fin.employee.task.dashboard.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="task_id"/>
                <field name="analytic_account_id"/>
                <field name="primary_employee_id"/>
                <field name="assignee_employee_id"/>
                <field name="manager_id" optional="hide"/>
                <field name="status" widget="badge" decoration-danger="status == 'pending'" decoration-warning="status == 'in_process'" decoration-success="status == 'done'"/>
                <field name="progress_pct" string="Progress (%)"/>
                <field name="target_start_date"/>
                <field name="target_end_date"/>
                <field name="last_update_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fin_employee_task_pivot" model="ir.ui.view">
        <field name="name">fin.employee.task.pivot</field>
        <field name="model">fin.employee.task</field>
        <field name="arch" type="xml">
            <pivot string="Task Analysis">
                <field name="status" type="row"/>
                <field name="manager_id" type="col"/>
                <field name="id" type="measure" string="Tasks"/>
                <field name="progress_avg" type="measure" string="Progress (%)"/>
                <field name="estimated_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_fin_employee_tasks" model="ir.actions.act_window">
        <field name="name">Employee Tasks</field>
        <field name="res_model">fin.employee.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fin_employee_task_search"/>
        <field name="context">{}</field>
    </record>

    <record id="action_fin_employee_tasks_dashboard" model="ir.actions.act_window">
        <field name="name">Task Status Dashboard</field>
        <field name="res_model">fin.employee.task.dashboard.report</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="views" eval="[(ref('view_fin_employee_task_dashboard_report_graph'), 'graph'), (ref('view_fin_employee_task_dashboard_report_pivot'), 'pivot'), (ref('view_fin_employee_task_dashboard_report_tree'), 'list')]"/>
        <field name="search_view_id" ref="view_fin_employee_task_dashboard_report_search"/>
        <field name="context">{'graph_measure': 'progress_pct'}</field>
    </record>
</odoo>
