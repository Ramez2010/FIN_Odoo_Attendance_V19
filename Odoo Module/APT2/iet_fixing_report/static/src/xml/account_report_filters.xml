<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="iet_fixing_report.AccountReportFilters" t-inherit="account_reports.AccountReportFiltersCustomizable" t-inherit-mode="extension">

        <xpath expr="//div[@id='filter_date']" position="after">

            <div id="iet_analytic_groupby_filter" class="filter_analytic_groupby" t-if="controller.options.analytic_groupby">
                <Dropdown>
                    <button class="btn btn-secondary dropdown-toggle">
                        <i class="fa fa-folder-open me-1"/>
                        <span>Analytic Group By</span>
                    </button>

                    <t t-set-slot="content">

                        <t t-foreach="this.analyticPlans" t-as="plan" t-key="plan.id">
                            <DropdownItem
                                class="{ 'selected': this.isPlanSelected(plan.id) }"
                                onSelected="() => this.onAnalyticFilterClick('analytic_plans_groupby', plan.id)"
                                closingMode="'none'"
                            >
                                <t t-esc="plan.name"/>
                            </DropdownItem>
                        </t>

                        <div class="dropdown-divider" t-if="this.analyticPlans.length > 0"/>

<!--                        <DropdownItem-->
<!--                            class="{ 'selected': (controller.options.analytic_accounts_groupby || []).length > 0 }"-->
<!--                            onSelected="() => this.onAnalyticFilterClick('analytic_accounts_groupby')"-->
<!--                            closingMode="'none'"-->
<!--                        >-->
<!--                            Select Accounts...-->
<!--                        </DropdownItem>-->

                    </t>
                </Dropdown>
            </div>
        </xpath>

    </t>

</templates>