<odoo>
    <record id="view_purchase_order_form_inherit_qty" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.qty</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='qty_received']" position="attributes">
                <attribute name="column_invisible">parent.state not in ('purchase', 'done')</attribute>
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='qty_received_method']" position="attributes">
                <attribute name="column_invisible">0</attribute>
                <attribute name="readonly">0</attribute>
            </xpath>

        </field>
    </record>
</odoo>