<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cron_generate_users_access_token" model="ir.cron">
            <field name="name">Generate User Access Token </field>
            <field name="interval_number">1</field>
            <field eval="True" name="active"/>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="user_id" ref="base.user_root"/>
            <field eval="False" name="doall"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=25)).strftime('%Y-%m-%d 22:00:00')"/>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="code">model._generate_default_access_token()</field>
        </record>
    </data>
</odoo>