<?xml version="1.0" encoding="utf-8" ?>
<odoo>


    <record id="overtime_category" model="ir.module.category">
        <field name="name">Overtime Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_overtime" model="res.groups.privilege">
        <field name="name">Overtime</field>
        <field name="category_id" ref="overtime_category"/>
        <field name="sequence">1</field>
    </record>

    <record id="overtime_user_group" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_overtime"/>
    </record>

    <record id="overtime_manager_group" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_overtime"/>
        <field name="implied_ids" eval="[(4, ref('overtime_user_group'))]"/>
    </record>

    <record id="record_rule_user" model="ir.rule">
        <field name="name">Overtime: User (Own Documents)</field>
        <field name="model_id" ref="model_overtime_request"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('overtime_user_group'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="record_rule_manager" model="ir.rule">
        <field name="name">Overtime: Manager (All Documents)</field>
        <field name="model_id" ref="model_overtime_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('overtime_manager_group'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>