<odoo>
    <data>
        <record id="view_res_config_settings_overtime" model="ir.ui.view">
        <field name="name">res.config.settings.overtime</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[string('settings')]" position="inside">
                <div class="app_settings_block" data-key="N" data-string="Overtime accounting"
                     string="Overtime accounting">
                    <div class="row mt16 o_settings_container">
                        <h2>Overtime accounting</h2>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <strong>Journal</strong>
                            <field name="overtime_journal_id" string="Journal"/>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <strong>Debit Account</strong>
                            <field name="overtime_debit_account_id"/>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <strong>Credit Account</strong>
                            <field name="overtime_credit_account_id"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    </data>
</odoo>

