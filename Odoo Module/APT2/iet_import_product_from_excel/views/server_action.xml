<odoo>
    <data>
        <record id="ir_action_server_action_product_custom" model="ir.actions.server">
            <field name="name">Generate Product Name</field>
            <field name="model_id" ref="stock.model_product_template"/>
            <field name="binding_model_id" ref="stock.model_product_template"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                action = record.generate_product_name()
            </field>
        </record>
    </data>
</odoo>