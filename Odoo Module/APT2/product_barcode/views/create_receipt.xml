<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_create_receipt" model="ir.ui.view">
        <field name="name">sale.order.create.receipt</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="get_receipt" icon="fa-dollar" string="Receipts"
                        invisible="receipt_count == 0">
                    <field string="Receipts" name="receipt_count" widget="statinfo"/>
                </button>
            </xpath>

            <xpath expr="//button[@id='quotation_send_primary']" position="before">
                <field name="flag" invisible="1"/>
                <button class="oe_highlight" string="Create Receipt" type="object" name="create_receipt"
                        groups="product_barcode.create_receipt"
                        invisible="state != 'sale' or selection_invoice == 'invoice'"/>
            </xpath>

            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">invoice_status != 'to invoice' or flag == True or selection_invoice == 'receipt'</attribute>
                <attribute name="groups">product_barcode.create_invoice</attribute>
            </xpath>

            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="selection_invoice" widget="radio" string="Invoice Type" />
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='qty_delivered']" position="after">
                <field name="receipt_quantity" column_invisible="parent.selection_invoice == 'invoice'"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='qty_delivered']" position="attributes">
                <attribute name="column_invisible">parent.selection_invoice == 'receipt'</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='qty_invoiced']" position="attributes">
                <attribute name="column_invisible">parent.selection_invoice == 'receipt'</attribute>
            </xpath>

        </field>
    </record>
</odoo>