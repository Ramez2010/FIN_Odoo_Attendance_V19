<odoo>
    <data>
        <!-- Category View -->
        <record id="view_sub_category_form" model="ir.ui.view">
            <field name="name">sub.category.form</field>
            <field name="model">sub.category</field>
            <field name="arch" type="xml">
                <form string="Sub Category">
                    <sheet>
                        <group>
                            <field name="higher_parent"/>
                            <field name="parent"/>
                            <field name="name"/>
                            <field name="serial"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_sub_category_tree" model="ir.ui.view">
            <field name="name">sub.category.tree</field>
            <field name="model">sub.category</field>
            <field name="arch" type="xml">
                <list string="Sub Category">
                    <field name="serial"/>
                    <field name="name"/>
                    <field name="parent"/>
                </list>
            </field>
        </record>

        <!-- Category Menu Action -->
        <record id="action_sub_category" model="ir.actions.act_window">
            <field name="name">Sub Categories</field>
            <field name="res_model">sub.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Category Menu Item -->
        <menuitem id="menu_sub_category" name="Sub Category" parent="stock.menu_stock_config_settings"
                  action="product_barcode.action_sub_category"/>

        <!-- Sequence -->
        <record id="sequence_sub_category" model="ir.sequence">
            <field name="name">Sub Category Sequence</field>
            <field name="code">sub.category.sequence</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>