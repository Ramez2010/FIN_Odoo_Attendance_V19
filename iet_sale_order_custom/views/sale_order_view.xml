<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="sale_order_custom1" model="ir.ui.view">
            <field name="name">sale_order_custom</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="display_project_id"/>
                    <field name="analytic_account_id" readonly="1" force_save="1"/>
                </xpath>

                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="employee"/>
                </xpath>

            </field>
        </record>

        <record id="ir_cron_sale_project_update" model="ir.cron">
            <field name="name">Update Sale Order Projects</field>

            <field name="model_id" ref="sale.model_sale_order"/>

            <field name="state">code</field>
            <field name="code">model.sale_project_update()</field>

            <field name="user_id" ref="base.user_root"/>

            <field name="interval_number">1</field>
            <field name="interval_type">months</field>

        </record>


    </data>
</odoo>