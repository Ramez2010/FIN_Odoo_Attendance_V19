<odoo>
    <data noupdate="1">

        <record id="ir_cron_mobikul_attendance_notification" model="ir.cron">
            <field name="name">Create Attendance Notification</field>
            <field name="model_id" ref="model_mobikul_attendance_notification"/>
            <field name="state">code</field>
            <field name="code">model.create_attendance_notification()</field>
            <field name="active" eval="True"/>
            <field name="interval_number" eval="1"/>
            <field name="interval_type">days</field>
            <field name="numbercall" eval="-1"/>
            <field name="nextcall"
                   eval="(datetime.now() + timedelta(days=1)).replace(hour=5, minute=0, second=0, microsecond=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="ir_cron_mobikul_departure_notification" model="ir.cron">
            <field name="name">Create Departure Notification</field>
            <field name="model_id" ref="model_mobikul_attendance_notification"/>
            <field name="state">code</field>
            <field name="code">model.create_departure_notification()</field>
            <field name="active" eval="True"/>
            <field name="interval_number" eval="1"/>
            <field name="interval_type">days</field>
            <field name="numbercall" eval="-1"/>
            <field name="nextcall"
                   eval="(datetime.now() + timedelta(days=1)).replace(hour=13, minute=0, second=0, microsecond=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="ir_cron_check_out_notifications_reminder" model="ir.cron">
            <field name="name">Check Out Notifications Reminder</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.check_out_notifications_reminder()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
        </record>

    </data>
</odoo>