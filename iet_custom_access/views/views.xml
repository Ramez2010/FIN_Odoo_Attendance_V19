<odoo>
    <record id="custom_access_validate_button" model="ir.ui.view">
        <field name="name">custom.access.validate.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_validate']" position="attributes">
                <attribute name="groups">iet_custom_access.group_validate_stock_picking</attribute>
            </xpath>
        </field>
    </record>

    <record id="custom_access_cancel_order" model="ir.ui.view">
        <field name="name">custom.access.cancel.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="groups">iet_custom_access.group_cancel_sale_order</attribute>
            </xpath>
        </field>
    </record>

</odoo>