<odoo>
    <data>
        <record id="hr_contract_view_form_inhe" model="ir.ui.view">
            <field name="name">hr_contract_view_form_inhe</field>
            <field name="model">hr.version</field>
            <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='hr_responsible_id']" position="after">
                    <field name="overtime_rate"/>
                    <field name="soci_emp"/>
                    <field name="soci_comp"/>
                    <field name="medical_ins_emp"/>
                    <field name="medical_ins_comp"/>
                </xpath>
                
            </field>
        </record>
    </data>
</odoo>