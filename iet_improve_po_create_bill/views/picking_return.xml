<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_return_picking_form_inherit_so_products" model="ir.ui.view">
        <field name="name">stock.return.picking.form.inherit.so.products</field>
        <field name="model">stock.return.picking</field>
        <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_id']" position="after">
                <field name="allowed_products" invisible="1"/>
            </xpath>

            <xpath expr="//list//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('id', 'in', parent.allowed_products)]</attribute>
                <attribute name="options">{"no_create": True,"no_edit" :True , "no_quick_create" :True}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
