<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_attendance_app.LiveMap">
        <div class="o_live_map_container d-flex h-100">
            <!-- Sidebar -->
            <div class="o_live_map_sidebar bg-white border-end d-flex flex-column" style="width: 350px; min-width: 350px;">
                <div class="p-3 border-bottom pb-0">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="m-0">Live Map</h5>
                    </div>
                    <!-- Tabs -->
                    
                </div>

                <div class="p-3 border-bottom shadow-sm">
                    <button class="btn btn-primary w-100 d-flex align-items-center justify-content-center" 
                            t-att-disabled="state.fetchingLocations"
                            t-on-click="requestLiveLocations">
                        <i class="fa fa-crosshairs me-2" t-att-class="state.fetchingLocations ? 'fa-spin' : ''"/>
                        <span t-if="!state.fetchingLocations">Fetch Locations</span>
                        <span t-else="">Fetching... (Refreshing in 7s)</span>
                    </button>
                </div>

                <div class="p-3 border-bottom">
                    <input type="text"
                           class="form-control"
                           placeholder="Filter employees"
                           t-model="state.filterText"/>
                </div>

                <div class="o_live_map_list flex-grow-1 overflow-auto">
                    <div class="p-3 border-bottom bg-light">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="selectAllCheckbox"
                                   t-att-checked="areAllSelected"
                                   t-on-change="(ev) => this.selectAllEmployees(ev.target.checked)"/>
                            <label class="form-check-label" for="selectAllCheckbox">
                                <strong>Select All</strong>
                            </label>
                        </div>
                    </div>
                    <t t-foreach="filteredEmployees" t-as="emp" t-key="emp.id">
                        <div class="o_employee_item p-3 border-bottom" t-on-click="() => this.zoomToEmployee(emp.id)">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" t-att-id="'emp_cb_' + emp.id"
                                       t-att-checked="state.selectedEmployeeIds.has(emp.id)"
                                       t-on-change="(ev) => this.onEmployeeSelectionChange(emp, ev.target.checked)"
                                       t-on-click.stop=""/>
                                <div class="form-check-label w-100">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="text-truncate" style="max-width: 150px;">
                                            <t t-esc="emp.name"/>
                                        </strong>
                                        <t t-set="location" t-value="state.locations.find(l => l.employee_id === emp.id)"/>
                                        <t t-if="location">
                                            <span class="badge rounded-pill"
                                                  t-att-class="location.is_reachable ? 'text-bg-success' : 'text-bg-danger'">
                                                <t t-esc="location.is_reachable ? 'Reachable' : 'Unreachable'"/>
                                            </span>
                                        </t>
                                    </div>
                                    <div class="small text-muted mt-1">
                                        <t t-if="location">
                                            <t t-if="!location.is_reachable">
                                                <i class="fa fa-exclamation-triangle me-1"/> <t t-esc="location.unreachable_reason"/>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-question-circle me-1"/> No location data
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <div t-if="!state.employees.length" class="p-5 text-center text-muted">
                        <i class="fa fa-users fa-3x mb-3 d-block opacity-25"/>
                        No employees are currently checked in.
                    </div>
                </div>
            </div>

            <!-- Map Area -->
            <div class="o_live_map_view flex-grow-1 position-relative">
                <div t-ref="mapContainer" class="h-100 w-100"/>
                <div t-if="state.error" class="position-absolute top-50 start-50 translate-middle alert alert-danger">
                    <t t-esc="state.error"/>
                </div>
            </div>
        </div>
    </t>
</templates>
