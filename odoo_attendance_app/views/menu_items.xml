<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Main Menu -->
    <menuitem id="menu_odoo_attendance_root"
              name="FIN Attendance"
              sequence="100"
              web_icon="odoo_attendance_app,static/description/icon.png"
              groups="group_odoo_attendance_manager,hr.group_hr_user"/>
    
    <!-- Sub Menus -->
    <menuitem id="menu_odoo_attendance_employees"
              name="Mobile App Employees"
              parent="menu_odoo_attendance_root"
              action="action_odoo_attendance_employee"
              sequence="10"/>
    
    <menuitem id="menu_odoo_attendance_sessions"
              name="App Sessions"
              parent="menu_odoo_attendance_root"
              action="action_odoo_attendance_session"
              sequence="20"/>

    <menuitem id="menu_live_employees_map"
              name="Live Map"
              parent="menu_odoo_attendance_root"
              action="action_live_employees_map"
              sequence="15"
              groups="hr.group_hr_user,odoo_attendance_app.group_odoo_attendance_manager"/>

    
    <!-- Link to standard Attendances -->
    <menuitem id="menu_odoo_attendance_hr_attendance"
              name="View Attendances"
              parent="menu_odoo_attendance_root"
              action="hr_attendance.hr_attendance_action"
              sequence="30"/>

    <menuitem id="menu_odoo_attendance_config"
              name="Settings"
              parent="menu_odoo_attendance_root"
              action="action_odoo_attendance_app_config_open"
              sequence="90"
              groups="hr.group_hr_user,group_odoo_attendance_manager"/>

    <menuitem id="menu_odoo_attendance_messages"
              name="Messages"
              parent="menu_odoo_attendance_root"
              action="action_odoo_attendance_inbox_messages"
              sequence="80"
              groups="hr.group_hr_user,group_odoo_attendance_manager"/>

</odoo>

