<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_attendance_app_config_form" model="ir.ui.view">
        <field name="name">odoo.attendance.app.config.form</field>
        <field name="model">odoo.attendance.app.config</field>
        <field name="arch" type="xml">
            <form string="Attendance App Settings" create="0" delete="0">
                <sheet>
                    <group>
                        <field name="selfie_retention_days" help="Delete selfie attachments older than this many days. Set to 0 to disable automatic deletion."/>
                    </group>
                    <group string="Messages">
                        <field name="message_timezone" placeholder="Africa/Cairo"/>
                    </group>
                    <group string="Live Map">
                        <field name="google_maps_api_key" placeholder="AIza..."/>
                    </group>
                    <group string="Cleanup Schedule">
                        <field name="cron_interval_number"/>
                        <field name="cron_interval_type"/>
                    </group>
                    <group string="Subscription Licensing">
                        <field name="license_server_url" placeholder="https://license.yourdomain.com"/>
                        <field name="license_key" password="True"/>
                        <button name="action_check_license_now" type="object" string="Check License Now" class="oe_highlight"/>
                        <separator string="Current Status"/>
                        <field name="license_status" readonly="1"/>
                        <field name="license_valid_until" readonly="1"/>
                        <field name="license_last_check" readonly="1"/>
                        <field name="license_employee_limit" readonly="1"/>
                        <field name="license_employee_count" readonly="1"/>
                        <field name="license_last_error" readonly="1"/>
                    </group>
                    <group string="Android Push (FCM)">
                        <field name="fcm_project_id" placeholder="your-firebase-project-id"/>
                        <field name="fcm_service_account_json" password="True" placeholder="Paste Firebase service account JSON here (recommended)."/>
                        <separator string="Legacy (deprecated)"/>
                        <field name="fcm_server_key" password="True" placeholder="Firebase server key (legacy - usually disabled)"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_attendance_app_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">odoo.attendance.app.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the settings record to manage selfie retention and cleanup scheduling.
            </p>
        </field>
        <field name="context">{'default_selfie_retention_days': 60, 'default_cron_interval_number': 1, 'default_cron_interval_type': 'days', 'create': False, 'delete': False}</field>
    </record>

    <record id="action_odoo_attendance_app_config_open" model="ir.actions.server">
        <field name="name">Settings</field>
        <field name="model_id" ref="odoo_attendance_app.model_odoo_attendance_app_config"/>
        <field name="state">code</field>
        <field name="code">action = env['odoo.attendance.app.config'].action_open_settings()</field>
    </record>
</odoo>
