<odoo>
    <data>
        <!-- Category View -->
        <record id="view_serial_category_form" model="ir.ui.view">
            <field name="name">serial.category.form</field>
            <field name="model">serial.category</field>
            <field name="arch" type="xml">
                <form string="Serial Category">
                    <sheet>
                        <group>
                            <field name="main_category"/>
                            <field name="higher_parent"/>
                            <field name="parent"/>
                            <field name="name"/>
                            <field name="serial"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_serial_category_tree" model="ir.ui.view">
            <field name="name">serial.category.tree</field>
            <field name="model">serial.category</field>
            <field name="arch" type="xml">
                <list string="Serial Category">
                    <field name="serial"/>
                    <field name="main_category"/>
                    <field name="higher_parent"/>
                    <field name="parent"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Category Menu Action -->
        <record id="action_serial_category" model="ir.actions.act_window">
            <field name="name">Serial Categories</field>
            <field name="res_model">serial.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Category Menu Item -->
        <menuitem id="menu_serial_category" name="Serial Category" parent="stock.menu_stock_config_settings"
                  action="product_barcode.action_serial_category"/>

        <!-- Sequence -->
        <record id="sequence_serial_category" model="ir.sequence">
            <field name="name">Serial Category Sequence</field>
            <field name="code">serial.category.sequence</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>