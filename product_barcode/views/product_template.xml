<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_inherit" model="ir.ui.view">
        <field name="name">product.template.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                    <field name="main_category_id"/>
                    <field name="vendor_category_id" domain="[('parent','=',main_category_id)]" string="Manufacture Category"/>
                    <field name="sub_category_id" domain="[('parent','=',vendor_category_id)]"/>
                    <field name="serial_category_id" domain="[('parent','=',sub_category_id)]"/>
                    <field name="check"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_inherit" model="ir.ui.view">
        <field name="name">account.move.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                    <field name="sale_id"/>
            </xpath>
        </field>
    </record>
</odoo>