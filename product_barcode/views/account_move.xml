<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="account_move_custom_view" model="ir.ui.view">
            <field name="name">account_mov_custom_view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='currency_id']"
                       position="attributes">
                    <attribute name="column_invisible">0</attribute>
                    <attribute name="invisible">0</attribute>
                </xpath>
                <xpath expr="//field[@name='sale_id']" position="after">
                    <field name="analytic_account_id_2" string="Analytic Account" invisible="1"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>