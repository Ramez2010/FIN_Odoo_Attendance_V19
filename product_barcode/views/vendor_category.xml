<odoo>
    <data>
        <!-- Category View -->
        <record id="view_vendor_category_form" model="ir.ui.view">
            <field name="name">vendor.category.form</field>
            <field name="model">vendor.category</field>
            <field name="arch" type="xml">
                <form string="Manufacture Category">
                    <sheet>
                        <group>
                            <field name="parent"/>
                            <field name="name"/>
                            <field name="serial"/>
                            <field name="partner"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_vendor_category_tree" model="ir.ui.view">
            <field name="name">vendor.category.tree</field>
            <field name="model">vendor.category</field>
            <field name="arch" type="xml">
                <tree string="Manufacture Category">
                    <field name="serial"/>
                    <field name="name"/>
                    <field name="parent"/>
                    <field name="partner"/>
                </tree>
            </field>
        </record>

        <!-- Category Menu Action -->
        <record id="action_vendor_category" model="ir.actions.act_window">
            <field name="name">Manufacture Categories</field>
            <field name="res_model">vendor.category</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Category Menu Item -->
        <menuitem id="menu_vendor_category" name="Manufacture Category" parent="stock.menu_stock_config_settings"
                  action="product_barcode.action_vendor_category"/>

        <!-- Sequence -->
        <record id="sequence_vendor_category" model="ir.sequence">
            <field name="name">Manufacture Category Sequence</field>
            <field name="code">vendor.category.sequence</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>