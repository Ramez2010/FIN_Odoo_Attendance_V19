<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_product_inherit" model="ir.ui.view">
        <field name="name">product.product.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tag_ids']" position="after">
                    <field name="main_category_id"/>
                    <field name="vendor_category_id" domain="[('parent','=',main_category_id)]" string="Manufacture Category"/>
                    <field name="sub_category_id" domain="[('parent','=',vendor_category_id)]"/>
                    <field name="serial_category_id" domain="[('parent','=',sub_category_id)]"/>
                    <field name="check"/>
            </xpath>
        </field>
    </record>
</odoo>