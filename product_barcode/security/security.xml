<odoo>
    <!-- category for groups -->
    <record id="category_create_edit" model="ir.module.category">
        <field name="name">Create / Edit Categories</field>
    </record>
    <record id="create_invoice_receipt" model="ir.module.category">
        <field name="name">Create Invoice / Receipt</field>
    </record>
    <!--  Groups  -->
    <!--  approval manger -->
    <record id="create_category" model="res.groups">
        <field name="name">Create Category</field>
        <field name="category_id" ref="category_create_edit"/>
    </record>
    <record id="edit_category" model="res.groups">
        <field name="name">Edit Category</field>
        <field name="category_id" ref="category_create_edit"/>
    </record>

    <record id="create_invoice" model="res.groups">
        <field name="name">Create Invoice</field>
        <field name="category_id" ref="create_invoice_receipt"/>
    </record>
    <record id="create_receipt" model="res.groups">
        <field name="name">Create Receipt</field>
        <field name="category_id" ref="create_invoice_receipt"/>
    </record>
</odoo>