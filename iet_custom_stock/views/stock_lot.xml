<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="stock_lot_custom_view" model="ir.ui.view">
            <field name="name">stock_lot_custom_view</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='product_qty']" position="after">
                    <field name="custom_quantity"/>
                    <field name="total_quantity"/>
                </xpath>

            </field>
        </record>

        <record id="view_stock_quant_tree_editable_custom" model="ir.ui.view">
            <field name="name">view_stock_quant_tree</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='lot_id']" position="after">
                    <field name="total_quantity"/>
                </xpath>
            </field>
        </record>



    </data>
</odoo>