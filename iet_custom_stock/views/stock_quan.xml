<odoo>
    <data>
        <record id="stock_quan_inherit_tree" model="ir.ui.view">
            <field name="name">stock_quan_inherit_tree</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="arch" type="xml">


                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="arabic_name" optional="show"/>
                </xpath>


            </field>
        </record>

        <record id="stock_quan_inherit_tree_editable" model="ir.ui.view">
            <field name="name">stock_quan_inherit_tree_editable</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="arabic_name" optional="show"/>
                </xpath>


            </field>
        </record>


    </data>
</odoo>