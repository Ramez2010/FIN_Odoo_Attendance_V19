<odoo>
    <data>

         <record id="view_stock_move_line_detailed_operation_tree_inh" model="ir.ui.view">
            <field name="name">stock.move.line.operations.tree.inh</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="arabic_name" optional="show"/>
                </xpath>
            </field>
        </record>



        <record id="view_picking_form_inherit" model="ir.ui.view">
            <field name="name">view_picking_form_inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">

                <xpath expr="//notebook/page/field[@name='move_ids_without_package']/tree/field[@name='product_id']"
                       position="after">
                    <field name="arabic_name"/>
                </xpath>

                <xpath expr="//notebook//page[@name='detailed_operations']//field[@name='move_line_ids_without_package']"
                       position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//notebook//page[@name='detailed_operations']//field[@name='move_line_ids_without_package']"
                       position="after">
                     <field name="move_line_ids_without_package"
                                   attrs="{'readonly': ['|', '|', ('show_operations', '=', False), ('state', '=', 'cancel'), '&amp;', ('state', '=', 'done'), ('is_locked', '=', True)], 'invisible': [('show_reserved', '=', False)]}"
                                   context="{'tree_view_ref': 'stock.view_stock_move_line_detailed_operation_tree', 'default_picking_id': id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id, 'default_company_id': company_id}"/>

                </xpath>
            </field>
        </record>


    </data>
</odoo>