<odoo>
    <data>

         <record id="view_stock_move_line_detailed_operation_tree_inh1" model="ir.ui.view">
            <field name="name">stock.move.line.operations.tree.inh</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="arabic_name" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="view_picking_form_inherit1" model="ir.ui.view">
            <field name="name">view_picking_form_inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">

                <xpath expr="//notebook/page/field[@name='move_ids']/list/field[@name='product_id']"
                       position="after">
                    <field name="arabic_name"/>
                </xpath>

                <xpath expr="//notebook//page[@name='operations']//field[@name='move_ids']"
                       position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//notebook//page[@name='operations']//field[@name='move_ids']"
                       position="after">
                     <field name="move_ids"
                            readonly="not show_operations or state == 'cancel' or (state == 'done' and is_locked)"
                            invisible="state in ('draft', 'done', 'cancel')"
                            context="{'tree_view_ref': 'stock.view_stock_move_line_detailed_operation_tree', 'default_picking_id': id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id, 'default_company_id': company_id}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>